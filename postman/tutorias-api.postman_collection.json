{
  "info": {
    "name": "Tutorias API - Flujo completo",
    "description": "Ejecuta en orden para crear el área, tutor, estudiante, disponibilidad, tutoría e inscripción. Las solicitudes finales prueban las reglas de conflicto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "areaId", "value": "" },
    { "key": "tutorId", "value": "" },
    { "key": "estudianteId", "value": "" },
    { "key": "disponibilidadId", "value": "" },
    { "key": "tutoriaId", "value": "" },
    { "key": "participanteId", "value": "" },
    { "key": "diaSemana", "value": "" },
    { "key": "fechaHoraInicio", "value": "" },
    { "key": "fechaHoraFin", "value": "" },
    { "key": "fechaHoraInicioActualizada", "value": "" },
    { "key": "fechaHoraFinActualizada", "value": "" }
  ],
  "item": [
    {
      "name": "0. Comprobar estado de la API",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('API disponible', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/estado" }
    },
    {
      "name": "1. Crear área",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Área creada', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('areaId', String(pm.response.json().id));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Matemáticas {{$guid}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/areas"
      }
    },
    {
      "name": "2. Consultar áreas",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/areas" }
    },
    {
      "name": "Consultar el área creada",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/areas/{{areaId}}" }
    },
    {
      "name": "3. Modificar área",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ciencias {{$guid}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/areas/{{areaId}}"
      }
    },
    {
      "name": "4. Crear tutor",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Tutor creado', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('tutorId', String(pm.response.json().id));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Carlos Tutor\",\n  \"correo\": \"carlos.{{$guid}}@example.com\",\n  \"areaId\": {{areaId}}\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/tutores"
      }
    },
    {
      "name": "5. Consultar tutores",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tutores" }
    },
    {
      "name": "Consultar el tutor creado",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tutores/{{tutorId}}" }
    },
    {
      "name": "6. Consultar disponibilidad del tutor",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tutores/{{tutorId}}/disponibilidad" }
    },
    {
      "name": "7. Modificar tutor",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Carlos Tutor Actualizado\",\n  \"correo\": \"carlos.{{$guid}}@example.com\",\n  \"areaId\": {{areaId}}\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/tutores/{{tutorId}}"
      }
    },
    {
      "name": "8. Crear estudiante",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Estudiante creado', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('estudianteId', String(pm.response.json().id));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana Estudiante\",\n  \"correo\": \"ana.{{$guid}}@example.com\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/estudiantes"
      }
    },
    {
      "name": "9. Consultar estudiantes",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/estudiantes" }
    },
    {
      "name": "Consultar el estudiante creado",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/estudiantes/{{estudianteId}}" }
    },
    {
      "name": "10. Modificar estudiante",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana Estudiante Actualizada\",\n  \"correo\": \"ana.{{$guid}}@example.com\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/estudiantes/{{estudianteId}}"
      }
    },
    {
      "name": "11. Crear disponibilidad para la próxima semana",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const fecha = new Date();", "fecha.setDate(fecha.getDate() + 7);", "const dias = ['SUNDAY', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'];", "pm.collectionVariables.set('diaSemana', dias[fecha.getDay()]);"] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Disponibilidad creada', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('disponibilidadId', String(pm.response.json().id));"] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tutorId\": {{tutorId}},\n  \"diaSemana\": \"{{diaSemana}}\",\n  \"horaInicio\": \"08:00:00\",\n  \"horaFin\": \"18:00:00\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/disponibilidades"
      }
    },
    {
      "name": "12. Modificar disponibilidad",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tutorId\": {{tutorId}},\n  \"diaSemana\": \"{{diaSemana}}\",\n  \"horaInicio\": \"08:00:00\",\n  \"horaFin\": \"19:00:00\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/disponibilidades/{{disponibilidadId}}"
      }
    },
    {
      "name": "13. Crear tutoría futura",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const inicio = new Date();", "inicio.setDate(inicio.getDate() + 7);", "inicio.setHours(10, 0, 0, 0);", "const fin = new Date(inicio.getTime() + 60 * 60 * 1000);", "const inicioActualizado = new Date(inicio.getTime() + 60 * 60 * 1000);", "const finActualizado = new Date(inicioActualizado.getTime() + 60 * 60 * 1000);", "const formato = fecha => `${fecha.getFullYear()}-${String(fecha.getMonth() + 1).padStart(2, '0')}-${String(fecha.getDate()).padStart(2, '0')}T${String(fecha.getHours()).padStart(2, '0')}:${String(fecha.getMinutes()).padStart(2, '0')}:00`;", "pm.collectionVariables.set('fechaHoraInicio', formato(inicio));", "pm.collectionVariables.set('fechaHoraFin', formato(fin));", "pm.collectionVariables.set('fechaHoraInicioActualizada', formato(inicioActualizado));", "pm.collectionVariables.set('fechaHoraFinActualizada', formato(finActualizado));"] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Tutoría creada', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('tutoriaId', String(pm.response.json().id));"] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tutorId\": {{tutorId}},\n  \"tema\": \"Repaso de matemáticas\",\n  \"fechaHoraInicio\": \"{{fechaHoraInicio}}\",\n  \"fechaHoraFin\": \"{{fechaHoraFin}}\",\n  \"limiteParticipantes\": 1\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/tutorias"
      }
    },
    {
      "name": "14. Modificar tutoría",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Tutoría modificada', () => pm.response.to.have.status(200));"] } }],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tutorId\": {{tutorId}},\n  \"tema\": \"Repaso de matemáticas actualizado\",\n  \"fechaHoraInicio\": \"{{fechaHoraInicioActualizada}}\",\n  \"fechaHoraFin\": \"{{fechaHoraFinActualizada}}\",\n  \"limiteParticipantes\": 1\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/tutorias/{{tutoriaId}}"
      }
    },
    {
      "name": "15. Consultar tutorías",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tutorias?tutorId={{tutorId}}&estado=PROGRAMADA" }
    },
    {
      "name": "16. Consultar una tutoría",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tutorias/{{tutoriaId}}" }
    },
    {
      "name": "17. Inscribir estudiante",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Inscripción creada', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('participanteId', String(pm.response.json().id));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"estudianteId\": {{estudianteId}}\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/tutorias/{{tutoriaId}}/participantes"
      }
    },
    {
      "name": "18. Consultar inscritos",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tutorias/{{tutoriaId}}/participantes" }
    },
    {
      "name": "19. Intentar inscribir otra vez (debe responder 409)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Rechaza inscripción duplicada', () => pm.response.to.have.status(409));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"estudianteId\": {{estudianteId}}\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/tutorias/{{tutoriaId}}/participantes"
      }
    },
    {
      "name": "20. Retirar inscripción (antes de iniciar)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/participantes/{{participanteId}}" }
    },
    {
      "name": "21. Eliminar estudiante sin inscripciones",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Estudiante eliminado', () => pm.response.to.have.status(204));"] } }],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/estudiantes/{{estudianteId}}" }
    },
    {
      "name": "22. Cambiar tutoría a cancelada",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"estado\": \"CANCELADA\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/tutorias/{{tutoriaId}}/estado"
      }
    },
    {
      "name": "23. Desactivar disponibilidad",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/disponibilidades/{{disponibilidadId}}" }
    },
    {
      "name": "24. Intentar eliminar tutor relacionado (debe responder 409)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Protege tutorías históricas', () => pm.response.to.have.status(409));"] } }],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/tutores/{{tutorId}}" }
    }
  ]
}
